index 0000000..c6ae1d0
--- /dev/null
+++ b/dataset/pjm.py
@@ -0,0 +1,113 @@
+"""
+PJM Korpus dataset adapter for upstream SpaMo (paper-faithful code).
+
+Wraps PJM HDF5 features (extracted in SpaMo-PJM fork) into the dict format
+expected by upstream `spamo.t5_slt.FlanT5SLT.get_inputs` (see t5_slt.py:331-410).
+
+Required sample dict fields:
+    pixel_value (Tensor [T, 2048]) : ViT spatial
+    glor_value  (Tensor [T, 1024]) : MAE motion (or list[Tensor])
+    text        (str)              : target sentence
+    gloss       (str)              : empty for PJM (no gloss annotations)
+    lang        (str)              : for prompt format, e.g. 'English'
+    id          (str)              : sample key
+    num_frames  (int)
+    en_text, fr_text, es_text (str): for in_context examples
+"""
+
+from pathlib import Path
+
+import h5py
+import pandas as pd
+import torch
+
+
+class PJMKorpus(torch.utils.data.Dataset):
+    def __init__(
+        self,
+        split_csv: str,
+        visual_features_path: str,
+        motion_features_path: str,
+        texts_path: str,
+        multilang_path: str | None = None,
+        target_lang: str = 'English',
+        drop_flagged: bool = False,
+        max_frame_length: int = 512,
+    ):
+        super().__init__()
+        df = pd.read_csv(split_csv)
+        if drop_flagged and 'flag' in df.columns:
+            df = df[df['flag'].fillna('') == '']
+        all_keys = df['key'].astype(str).tolist()
+
+        # TemporalConv conv_type=2 = [K5, P2, K5, P2]: requires >= ~16 input frames.
+        # Filter out PJM samples too short for the temporal encoder.
+        min_frames = 16
+        with h5py.File(visual_features_path, 'r') as f:
+            self.keys = [k for k in all_keys if k in f and f[k].shape[0] >= min_frames]
+        dropped = len(all_keys) - len(self.keys)
+        if dropped:
+            print(f"[PJMKorpus] {split_csv}: dropped {dropped} samples with < {min_frames} ViT frames")
+        self.visual_features_path = visual_features_path
+        self.motion_features_path = motion_features_path
+        self.texts_path = texts_path
+        self.multilang_path = multilang_path
+        self.target_lang = target_lang
+        self.max_frame_length = max_frame_length
+
+        self._vit = None
+        self._mae = None
+        self._texts = None
+        self._multilang = None
+
+    def _open(self):
+        if self._vit is None:
+            self._vit = h5py.File(self.visual_features_path, 'r')
+            self._mae = h5py.File(self.motion_features_path, 'r')
+            self._texts = h5py.File(self.texts_path, 'r')
+            self._multilang = h5py.File(self.multilang_path, 'r') if self.multilang_path else None
+
+    def __getitem__(self, idx: int) -> dict:
+        self._open()
+        key = self.keys[idx]
+        vit = torch.from_numpy(self._vit[key][()])
+        mae = torch.from_numpy(self._mae[key][()])
+
+        text = self._texts[key][()].decode().strip()
+        if not text.endswith('.'):
+            text += '.'
+
+        # Random crop spatial if too long (mirror PJMKorpus from SpaMo-PJM fork)
+        n = vit.size(0)
+        if n > self.max_frame_length:
+            import random
+            start = random.randint(0, n - self.max_frame_length)
+            vit = vit[start:start + self.max_frame_length]
+
+        out = {
+            'id': key,
+            'pixel_value': vit,
+            'num_frames': vit.size(0),
+            'glor_value': mae,
+            'text': text,
+            'gloss': '',  # PJM has no gloss annotations
+            'lang': self.target_lang,
+        }
+
+        # Multilang in-context (used when t5_slt.use_in_context=True)
+        if self._multilang is not None and key in self._multilang:
+            grp = self._multilang[key]
+            out['en_text'] = grp['en'][()].decode() if 'en' in grp else text
+            out['fr_text'] = grp['fr'][()].decode() if 'fr' in grp else text
+            out['es_text'] = grp['es'][()].decode() if 'es' in grp else text
+        else:
+            out['en_text'] = out['fr_text'] = out['es_text'] = text
+
+        return out
+
+    def __len__(self) -> int:
+        return len(self.keys)
+
+    @staticmethod
+    def collate_fn(batch):
+        return batch
