+# Fine-tune upstream SpaMo (paper-faithful code) on PJM, MS split.
+# Init from the released spamo.ckpt (PHOENIX-2014T DE->DE, BLEU 25.40 ground truth).
+# Goal: a clean test of PHOENIX-2014T to PJM transfer with paper-faithful SpaMo.
+model:
+  target: spamo.t5_slt.FlanT5SLT
+  params:
+    lr: 6.0e-4
+    monitor: val/bleu4
+    model_name: google/flan-t5-xl
+    cache_dir: null
+    inter_hidden: 768
+    input_size: 2048
+    beam_size: 5
+    max_frame_len: 512
+    max_txt_len: 64
+    frame_sample_rate: 1
+    prompt: "Translate the given sentence into {}."
+    tuning_type: lora
+    lora_r: 16
+    lora_alpha: 32
+    lora_dropout: 0.1
+    fusion_mode: joint
+    warm_up_steps: 0
+    cross_modal_align: true
+    combined_loss: true
+    alpha: 1.0
+    use_in_context: true
+    num_in_context: 3
+
+lightning:
+  callback:
+    learning_rate_logger:
+      target: pytorch_lightning.callbacks.LearningRateMonitor
+      params:
+        logging_interval: step
+  trainer:
