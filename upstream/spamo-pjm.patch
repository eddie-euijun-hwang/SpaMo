@@ -0,0 +1,24 @@
+#!/bin/bash
+# SpaMo and Mod-SpaMo PHOENIX SI rerun on the filtered SI split, mirroring the MS lineage
+# (registered in the paper's facts.md on 2026-10-30). Starts when the final ensemble frees the GPU.
+set -euo pipefail
+export WANDB_MODE=offline
+exec >>"$HOME/SpaMo/run_phoenix_si.log" 2>&1
+while pgrep -f "[g]reedy_ens.py" >/dev/null; do sleep 60; done
+until [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits | head -1)" -lt 1024 ]; do sleep 30; done
+
+echo "start spamo si $(date)"
+cd "$HOME/SpaMo"
+.venv/bin/python main.py -c configs/finetune_pjm_si.yaml --ckpt spamo.ckpt -e bleu --patience 5 -n finetune_pjm_si_upstream
+best=$(ls -t logs/*_finetune_pjm_si_upstream/checkpoints/*.ckpt | head -1)
+echo "spamo si best $HOME/SpaMo/$best $(date)"
+
+cd "$HOME/SpaMo-PJM-4f11b72"
+py="$HOME/SpaMo-PJM/.venv/bin/python"
+"$py" main.py -c configs/si_v26_dual.yaml --ckpt "$HOME/SpaMo/$best" -t False --test True -n test_upstream_pjm_si_dual
+echo "start mod-spamo si $(date)"
+"$py" main.py -c configs/si_v27_quad.yaml --ckpt "$HOME/SpaMo/$best" -e bleu -n finetune_v27_quad_xattn_si_filtered
+mbest=$(ls -t logs/*_finetune_v27_quad_xattn_si_filtered/checkpoints/*.ckpt | head -1)
+echo "mod-spamo si best $mbest $(date)"
+"$py" main.py -c configs/si_v27_quad.yaml --ckpt "$mbest" -t False --test True -n test_v27_quad_si_filtered
+echo "end $(date)"
