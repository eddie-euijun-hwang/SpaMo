+++ b/run_eval_pipeline.sh
@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+set -e
+cd "$(dirname "$0")"
+
+LOG="eval_pipeline.log"
+echo "[$(date)] === START ===" > "$LOG"
+
+# 1. Install deps (idempotent: uv pip skips already installed)
+echo "[$(date)] installing deps..." >> "$LOG"
+uv pip install --python .venv/bin/python -r requirements.txt >> "$LOG" 2>&1
+
+# 2. Verify torch + lightning + transformers present
+echo "[$(date)] verifying imports..." >> "$LOG"
+.venv/bin/python -c "
+import torch, pytorch_lightning, transformers, peft
+print('torch', torch.__version__)
+print('pl', pytorch_lightning.__version__)
+print('transformers', transformers.__version__)
+print('peft', peft.__version__)
+print('cuda', torch.cuda.is_available(), torch.cuda.device_count())
+" >> "$LOG" 2>&1
+
+# 3. Run eval: upstream code, official ckpt, our features
+echo "[$(date)] running eval..." >> "$LOG"
+.venv/bin/python main.py \
+    -c configs/eval_local_features.yaml \
+    --ckpt spamo.ckpt \
+    --train False --test True -e bleu \
+    -n eval_upstream_groundtruth >> "$LOG" 2>&1
+
+echo "[$(date)] === DONE ===" >> "$LOG"
